TOKEN=isi_token_bot_discord_di_sini
PREFIX=!
LOG_CHANNEL_ID=isi_id_channel_untuk_activity_log
LIVE_CHANNEL_ID=isi_id_channel_untuk_notifikasi_live
LIVE_POLL_INTERVAL_MS=180000
# Opsional. Lewat Docker sudah otomatis keisi, tidak perlu diubah.
# Kalau jalanin `npm start` langsung di Linux tanpa Google Chrome ter-install,
# isi ini dengan path binary Chromium/Chrome yang ada di mesin kamu.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
