TOKEN=isi_token_bot_discord_di_sini
PREFIX=!
LOG_CHANNEL_ID=isi_id_channel_untuk_activity_log
# Opsional, cuma perlu kalau yt-dlp/ffmpeg tidak ada di PATH (mis. dev lokal di luar Docker).
# Lewat Docker sudah otomatis ke-install, tidak perlu diisi.
# YTDLP_PATH=/usr/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# Opsional. Isi kalau !play gagal dengan error "Sign in to confirm you're not a bot"
# (umum terjadi kalau bot di-hosting di VPS). Lihat README bagian Music Player buat
# cara ambil cookies.txt-nya.
# YTDLP_COOKIES_PATH=/app/cookies.txt
